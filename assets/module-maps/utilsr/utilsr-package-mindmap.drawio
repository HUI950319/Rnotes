        <mxCell id="p3-x1" value="统一进 fmt_* 链加工" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F5FA9;strokeWidth=1.8;dashed=1;dashPattern=5 4;opacity=85;exitX=0.22;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#1F5FA9;labelBackgroundColor=#F8FAFD;verticalAlign=middle;" edge="1" parent="1" source="p3-ob-01" target="p3-ob-08">
