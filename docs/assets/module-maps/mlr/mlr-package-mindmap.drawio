        <mxCell id="p3-base-l" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#5A6B80;font-weight:700&quot;&gt;plt_bar_per()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13px;color:#607086;font-weight:400&quot;&gt; ← 03 / 04 / 07 复用      &lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#5A6B80;font-weight:700&quot;&gt;plt_circle()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13px;color:#607086;font-weight:400&quot;&gt; ← 01 复用      &lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#5A6B80;font-weight:700&quot;&gt;plt_beeswarm_circ()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13px;color:#607086;font-weight:400&quot;&gt; ← 04 复用      &lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#5A6B80;font-weight:700&quot;&gt;plt_interboot()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13px;color:#607086;font-weight:400&quot;&gt; ← 06 复用      &lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#AE3B2A;font-weight:700&quot;&gt;plt_viv()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13px;color:#607086;font-weight:400&quot;&gt; ← 04 / 07 复用（清单归在 07）&lt;/span&gt;&lt;/div&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=14.5;fontColor=#5A6B80;" vertex="1" parent="p3-base">
