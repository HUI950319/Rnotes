        <mxCell id="p3-base-t" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:18px;color:#5A6B80;font-weight:700&quot;&gt;08 通用可视化&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:14px;color:#607086;font-weight:400&quot;&gt;   底层图元层 · 被上方模块直接调用&lt;/span&gt;&lt;/div&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#5A6B80;fontStyle=1;" vertex="1" parent="p3-base">
