+    args <- if (is.character(mode)) list(family = stats::binomial()) else if (mode)
+      list(x = TRUE, y = TRUE) else list(cause = 1, variance = FALSE)
+    native <- do.call(original, c(list(formula = form, data = d), args))
+    native$call$formula <- form
+    count <- 0L
+    fits <- list()
+    events <- integer()
+    spy <- function(...) {
+      # Evaluate arguments so the stored native call has no dangling ..n
+      # references to this spy's dots when Score evaluates it later.
+      fit <- do.call(original, list(...))
+      count <<- count + 1L
+      fits[[count]] <<- fit
+      dd <- list(...)[["data"]]
+      events[count] <<- sum(dd[[if (identical(mode, FALSE)) "event" else "DSS"]] == 1)
+      fit
+    }
+    for (reps in c(0L, 3L)) {
+      set.seed(87)
+      ref <- suppressMessages(riskRegression::Score(
+        list(Age = native), formula = if (is.character(mode)) DSS ~ 1 else if (mode)
+          Surv(time, DSS) ~ 1 else Hist(time, event) ~ 1,
+        data = d, metrics = c("auc", "brier"),
+        plots = if (reps == 0L) "ROC" else "boxplot",
+        times = if (is.character(mode)) NULL else c(24, 60),
+        null.model = FALSE, contrasts = FALSE,
+        split.method = if (reps == 0L) "none" else "bootcv", B = reps, cl = 10L
+      ))
+      ref_rng <- .Random.seed
+      local({
+        environment(spy)$count <- 0L
+        environment(spy)$fits <- list()
+        environment(spy)$events <- integer()
+        do.call(testthat::local_mocked_bindings,
+                c(stats::setNames(list(spy), fun), list(.package = pkg, .env = environment())))
+        set.seed(87)
+        invisible(capture.output(out <- suppressMessages(get_score(
+          d, "Age", surv = mode, timepoint = c(24, 60), R = reps,
+          metrics = c("AUC", "BS", "AIC", "BIC", "PVE")
+        ))))
+        expect_identical(environment(spy)$count, reps + 1L)
+        expect_identical(.Random.seed, ref_rng)
+        for (m in c("AUC", "Brier")) {
+          expect_equal(as.data.frame(out[[m]]$score), as.data.frame(ref[[m]]$score),
+                       tolerance = 1e-12)
+        }
+        fit_stats <- out$fit.stats
+        expect_identical(fit_stats$info$R_success, reps)
+        expect_equal(fit_stats$info$n, nrow(d))
+        expect_equal(fit_stats$info$bic_n, if (is.character(mode)) nrow(d) else
+                       sum(d[[if (mode) "DSS" else "event"]] == 1))
+        recorded <- environment(spy)$fits
+        expected <- lapply(seq_along(recorded), function(j) {
+          fit <- recorded[[j]]
+          ll <- if (identical(mode, FALSE)) fit$crrFit$loglik else
+            as.numeric(stats::logLik(fit))
+          ll0 <- if (identical(mode, FALSE)) fit$crrFit$loglik.null else if (isTRUE(mode))
+            fit$loglik[1] else ll - (fit$null.deviance - fit$deviance) / 2
+          k <- if (identical(mode, FALSE)) length(fit$crrFit$coef) else
+            attr(stats::logLik(fit), "df")
+          c(AIC = -2 * ll + 2 * k,
+            BIC = -2 * ll + log(if (is.character(mode)) nrow(d) else
+                                  environment(spy)$events[j]) * k,
+            PVE = -expm1(-2 * (ll - ll0) / nrow(d)))
+        })
+        expect_equal(fit_stats$stats$estimate, unname(expected[[1]]), tolerance = 1e-10)
+        if (reps >= 2L) {
+          # Verify all criteria against the recorded native training fits.
+          expect_equal(fit_stats$boot$AIC, vapply(expected[-1], `[[`, numeric(1), "AIC"))
+          expect_equal(fit_stats$boot$BIC, vapply(expected[-1], `[[`, numeric(1), "BIC"))
+          expect_equal(fit_stats$boot$PVE, vapply(expected[-1], `[[`, numeric(1), "PVE"))
+          for (m in c("AIC", "BIC", "PVE")) {
+            row <- fit_stats$stats[fit_stats$stats$metric == m, ]
+            expect_equal(c(row$lower, row$upper),
+                         unname(stats::quantile(fit_stats$boot[[m]], c(0.025, 0.975))))
+            expect_equal(row$SE, stats::sd(fit_stats$boot[[m]]))
+          }
+        }
+        expect_true(all(fit_stats$stats$estimate[fit_stats$stats$metric == "PVE"] >= 0))
+      })
+    }
+  })
+})
+
+test_that("get_score metrics compute only selected predictions and support likelihood only", {
+  d <- score_metrics_data()
+  for (metric in c("AUC", "BS")) {
+    invisible(capture.output(out <- get_score(d, "Age", timepoint = c(24, 200),
+                                               metrics = metric)))
+    expect_named(out$AUC.BS.AIC, c("model", metric))
+    expect_null(out[[if (metric == "AUC") "Brier" else "AUC"]])
+    p <- out[[if (metric == "AUC") "plt.AUC" else "plt.BS"]]
+    expect_s3_class(p, "ggplot")
+    built <- ggplot2::ggplot_build(p)
+    expect_true(any(built$data[[1]]$x == 200))
+    expect_null(out$plt.combined)
+    expect_equal(get_score_summary(out), out$AUC.BS.AIC)
+    expect_s3_class(plt_score(out), "ggplot")
+  }
+  count <- 0L
+  original <- riskRegression::FGR
+  testthat::local_mocked_bindings(FGR = function(...) {
+    count <<- count + 1L
+    original(...)
+  }, .package = "riskRegression")
+  # Likelihood-only requests must bypass Score rather than evaluating risks.
+  testthat::local_mocked_bindings(Score = function(...) stop("Score must not run"),
+                                  .package = "riskRegression")
+  set.seed(18)
+  invisible(capture.output(out <- get_score(d, list(c("Age", "Sex")), surv = FALSE,
+    R = 3, metrics = c("PVE", "BIC", "AIC"))))
+  expect_identical(count, 4L)
+  expect_null(out$obj)
+  expect_named(out$AUC.BS.AIC, c("model", "PVE", "BIC", "AIC"))
+  expect_equal(out$fit.stats$info$R_success, 3L)
+  expect_null(plt_score(out))
+})
+
+test_that("get_score metrics validate selection and pair models on a common sample", {
+  d <- score_metrics_data()
+  for (bad in list(character(), "Brier", c("AUC", "AUC"), c("AUC", NA), 1)) {
+    expect_error(get_score(d, "Age", metrics = bad), "metrics")
+  }
+  expect_error(get_score(d, "Age", R = 1.5), "R")
+  d$Age[1] <- NA_real_
+  withr::local_seed(9)
+  invisible(capture.output(out <- suppressMessages(get_score(
+    d, list(a = "Age", b = "Age", sex = "Sex"), R = 3,
+    timepoint = c(24, 60), metrics = c("BS", "BIC", "PVE")
+  ))))
+  expect_equal(out$fit.stats$info$n, rep(nrow(d) - 1L, 3L))
+  expect_equal(out$fit.stats$info$n_omitted, rep(1L, 3L))
+  expect_named(out$fit.stats$obj, c("a", "b", "sex"))
+  expect_identical(unique(out$fit.stats$stats$metric), c("BIC", "PVE"))
+  expect_equal(unname(as.matrix(out$fit.stats$boot[
+    out$fit.stats$boot$model == "a", c("BIC", "PVE")])),
+    unname(as.matrix(out$fit.stats$boot[
+      out$fit.stats$boot$model == "b", c("BIC", "PVE")])))
+  invisible(capture.output(log_out <- get_score(d[-1, ], Age, surv = "DSS",
+                                                 metrics = "AUC")))
+  expect_s3_class(log_out$plt.ROC, "ggplot")
+  expect_null(log_out$plt.AUC)
+  expect_null(log_out$plt.BS)
+})
